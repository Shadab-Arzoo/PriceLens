<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rich Obsidian to Royal Azure deep backdrop -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#0B0F19" />
                <item android:offset="0.45" android:color="#111B33" />
                <item android:offset="1.0" android:color="#1E3A8A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ambient glowing radial prism glow in the center -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="48"
                android:centerY="46"
                android:gradientRadius="48"
                android:type="radial">
                <item android:offset="0.0" android:color="#3538BDF8" />
                <item android:offset="0.55" android:color="#152563EB" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Concentric optics aperture depth rings -->
    <path
        android:pathData="M48,18 A30,30 0 1,1 47.9,18 Z"
        android:strokeWidth="0.75"
        android:strokeColor="#18FFFFFF"
        android:fillColor="#00000000" />

    <path
        android:pathData="M48,8 A40,40 0 1,1 47.9,8 Z"
        android:strokeWidth="0.5"
        android:strokeColor="#0DFFFFFF"
        android:fillColor="#00000000" />
